 AutoOperateMoneyPrinter = v
    
    if AutoOperateMoneyPrinter then
        pcall(function()
            AutoOperateMoneyPrinterFunc()
        end)
    end
end)

AutoOperateMoneyPrinterFunc = function()
    while AutoOperateMoneyPrinter and task.wait() do
        local printerObject = game:GetService("Workspace").MoneyPrinterArea.MoneyPrinter
        if #printerObject.Cash:GetChildren() > 0 then 
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = printerObject.Main.CFrame
            task.wait()
            fireproximityprompt(game:GetService("Workspace").MoneyPrinterArea.MoneyPrinter.Main.Attachment.ProximityPrompt)
        end
    end
end
